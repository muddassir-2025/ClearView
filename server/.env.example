# ─────────────────────────────────────────────────────────────
# ClearView Good Post backend — environment template.
#
# Copy to `.env` locally and fill in. NEVER commit the real .env. In production
# these go in the host's secret store (Render → Environment).
#
# Every variable below is read by `src/env.ts`. Anything not listed here is not
# read by the server at all — a leftover from a removed module is worse than a
# missing one, because it looks like configuration.
#
#   [required]  the server refuses to boot without it
#   [prod]      required when NODE_ENV=production, checked at boot
#   everything else has a default and only needs setting to change it
# ─────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Used for absolute URLs the server hands out. On Render, set this to the
# service's own URL.
PUBLIC_BASE_URL=http://localhost:8080
# Browser origins allowed to call this API, comma-separated. Leave EMPTY for the
# native Android client — it sends no Origin and needs no CORS headers. Never
# "*" in production.
CORS_ORIGINS=

# ── Neon PostgreSQL ───────────────────────────────────────────
# Neon → Dashboard → Connection string. Use the POOLED host (…-pooler.…) for the
# running service; keep the direct (non-pooler) string for migrations, which
# need a session connection for advisory locks.
# [required]
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/clearview?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/clearview?sslmode=require
PG_POOL_MAX=10

# ── Auth secrets ──────────────────────────────────────────────
# Long random values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# [required] all three
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Used only to hash values that must not be stored in the clear.
PHONE_HASH_PEPPER=

# ── The first super administrator (§17) ───────────────────────
# Reconciled at boot and by `npm run create-admin`. These belong only in the
# host's secret store — never in the Android app, never in git.
#
# Prefer SUPER_ADMIN_PASSWORD_HASH: the bcrypt hash, which is what the server
# would store anyway. SUPER_ADMIN_PASSWORD is accepted as an alternative for a
# deployment holding a plaintext secret; it is hashed once at boot and never
# stored. Generate a hash with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
#
# [prod] SUPER_ADMIN_EMAIL — without it the server refuses to start.
# Once this account exists the rest are created from inside the app by a super
# administrator, and it is never overwritten from here: a redeploy must not undo
# a password rotation.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=
# SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=Good Post Admin

# Shown by the app's "Don't have channel access?" line (§16). Public, and it
# should be the deployment's own address.
ADMIN_CONTACT_EMAIL=
ADMIN_ACCESS_TOKEN_TTL=10m
ADMIN_SESSION_TTL_DAYS=7
# The floor for a channel administrator's password.
ADMIN_MIN_PASSWORD_LENGTH=12

# ── Amazon S3 (needed for post media; text posts work without it) ──
# Backend-controlled uploads only: the Android client never sees these
# credentials. It receives short-lived presigned URLs instead. With no bucket
# set, media uploads answer `media_unavailable` and everything else keeps
# working (§22).
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set when running on infrastructure with an attached role, in which case leave
# the two keys above EMPTY and the SDK resolves credentials itself.
AWS_USE_INSTANCE_ROLE=false
S3_UPLOAD_URL_TTL=900
S3_DOWNLOAD_URL_TTL=3600
# Max accepted upload size (bytes), enforced when issuing an upload URL.
S3_MAX_UPLOAD_BYTES=104857600
# An upload URL that was issued but never claimed is swept after this long.
UPLOAD_CLAIM_WINDOW_MINUTES=60

# ── Product rules ─────────────────────────────────────────────
# How many files one post may carry.
MAX_POST_MEDIA=4
# How long an administrator may edit a post after publishing it.
EDIT_WINDOW_DAYS=30
MAX_TEXT_LENGTH=4000
MAX_CHANNEL_NAME_LENGTH=80
MAX_CHANNEL_DESCRIPTION_LENGTH=500
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100
# Notifications are a device-local preference until real push exists (§14).
DEFAULT_NOTIFICATIONS_ENABLED=false

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=12
WRITE_RATE_LIMIT_MAX=40
# Per-IDENTITY, not per-IP: counts a single account's failed sign-ins and locks
# it, so an attacker cannot spend one address's allowance from many addresses.
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ── Cleanup job ───────────────────────────────────────────────
# Two passes: abandoned uploads, and posts an administrator deleted (their rows
# and their S3 objects). Nothing expires posts on a schedule — a channel's
# history stays until someone deletes it.
RETENTION_CRON=*/30 * * * *
RETENTION_JOB_ENABLED=true
# How long a deleted post's rows survive before the physical delete.
PURGE_GRACE_DAYS=0
# Rows per sweep.
PURGE_BATCH_SIZE=200
