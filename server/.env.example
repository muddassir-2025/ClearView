# ─────────────────────────────────────────────────────────────
# ClearView Good Post backend — environment template.
# Copy to `.env` locally and fill in. NEVER commit the real .env.
# In production set these in the host's secret store (Render).
#
# This file was migrated from the earlier "ClearView Channels"
# (MongoDB + Mongoose) design. The product rules, auth secrets and
# ban/retention settings below are preserved verbatim — only the
# datastore (Mongo → Neon Postgres) and media (new: S3) changed.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://api.your-domain.example

# Browser origins allowed to call this API, comma-separated. Leave EMPTY for
# the native Android client — it sends no Origin and needs no CORS headers.
# Never set this to "*" in production.
# Set it to the admin dashboard's origin once that ships (M6).
CORS_ORIGINS=

# ── Neon PostgreSQL (REQUIRED) ────────────────────────────────
# Neon → Dashboard → Connection string. Use the POOLED host
# (…-pooler.…) for the running service; keep the direct
# (non-pooler) string for migrations, which need a session
# connection for advisory locks.
# Both are accepted; only DATABASE_URL is required.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/clearview?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/clearview?sslmode=require
PG_POOL_MAX=10

# ── Auth secrets (REQUIRED) ───────────────────────────────────
# Long random values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Pepper for privacy-preserving phone hashing (REQUIRED).
# Mobile numbers are NEVER stored in plaintext: only
# HMAC-SHA256(E.164, pepper) is persisted, which is what makes
# §19 mobile-identity bans work without holding user phone data.
# PHONE_HASH_PEPPER_VERSION lets the pepper be rotated without
# losing existing ban history.
PHONE_HASH_PEPPER=replace-with-a-long-random-pepper
PHONE_HASH_PEPPER_VERSION=1

# ── The first super administrator (§17) ───────────────────────
# Reconciled at boot, and by `npm run create-admin`. These values must live
# only in the host's secret store — never in the Android app, never in git.
#
# Prefer SUPER_ADMIN_PASSWORD_HASH: the bcrypt hash, which is what the server
# would store anyway. SUPER_ADMIN_PASSWORD is accepted as an alternative for a
# deployment that holds a plaintext secret, and is hashed once at boot; it is
# read and never stored. Generate a hash with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
#
# Once this account exists, the rest are created from inside the app by a super
# admin, and it is never overwritten from here — a redeploy must not undo a
# password rotation.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=
# SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=Good Post Admin

# Shown by the app's "Don't have channel access?" line (§16). Public, and the
# deployment's own address rather than ours.
ADMIN_CONTACT_EMAIL=

# ── Amazon S3 (REQUIRED for post media) ───────────────────────
# Backend-controlled uploads only: the Android client never sees these
# credentials. It receives short-lived presigned URLs instead.
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: set when running on infrastructure with an attached role, in which
# case leave the two keys above EMPTY and the SDK resolves credentials itself.
AWS_USE_INSTANCE_ROLE=false
# Presigned URL lifetimes (seconds).
S3_UPLOAD_URL_TTL=900
S3_DOWNLOAD_URL_TTL=3600
# Max accepted upload size (bytes) — enforced when issuing an upload URL.
S3_MAX_UPLOAD_BYTES=104857600

# ── Product rules ─────────────────────────────────────────────
# Server-side post history window (§11). New followers can read back this far;
# never hard-coded anywhere in the codebase.
#
# 30 days is the storage model, not a cost limit: the server keeps the short
# history and the DEVICE keeps the long one (§10). Media a user downloaded is in
# their own storage and is never removed by this window — only the server's copy
# is, once it falls outside it. Reducing this number therefore makes the app
# leaner without taking anything away from a user who saved it.
GOODPOST_HISTORY_DAYS=30
# Grace between business expiry and the physical purge.
#
# 0 means the sweep deletes an expired post — and its S3 objects — on its next
# run, so the server holds nothing past the window above. Raise it only if a
# deployment ever needs a recovery window; the product rule is device-first
# storage, so the default keeps nothing that the phone could not keep itself.
PURGE_GRACE_DAYS=0
EDIT_WINDOW_DAYS=30
BAN_PHONE_ENFORCED=true
MAX_TEXT_LENGTH=4000
MAX_CHANNEL_NAME_LENGTH=80
MAX_CHANNEL_DESCRIPTION_LENGTH=500
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100
DEFAULT_NOTIFICATIONS_ENABLED=false

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=12
WRITE_RATE_LIMIT_MAX=40
# Per-IDENTITY, not per-IP: counts a single account's failed sign-ins and locks
# it, so an attacker cannot spend one address's allowance from many addresses.
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ── Administrators (§16–§19) ────────────────────────────────
ADMIN_ACCESS_TOKEN_TTL=10m
ADMIN_SESSION_TTL_DAYS=7
# The floor for a channel administrator's password.
ADMIN_MIN_PASSWORD_LENGTH=12

# ── Retention job ─────────────────────────────────────────────
RETENTION_CRON=*/30 * * * *
RETENTION_JOB_ENABLED=true
