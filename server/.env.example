# ─────────────────────────────────────────────────────────────
# ClearView Good Post backend — environment template.
#
# Copy to `.env` locally and fill in. NEVER commit the real .env. In production
# these go in the host's secret store (Render → Environment).
#
# Every variable below is read by `src/env.ts`. Anything not listed here is not
# read by the server at all — a leftover from a removed module is worse than a
# missing one, because it looks like configuration.
#
#   [required]  the server refuses to boot without it
#   [prod]      required when NODE_ENV=production, checked at boot
#   everything else has a default and only needs setting to change it
# ─────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Used for absolute URLs the server hands out. On Render, set this to the
# service's own URL.
PUBLIC_BASE_URL=http://localhost:8080
# Browser origins allowed to call this API, comma-separated. Leave EMPTY for the
# native Android client — it sends no Origin and needs no CORS headers. Never
# "*" in production.
CORS_ORIGINS=

# ── Neon PostgreSQL ───────────────────────────────────────────
# Neon → Dashboard → Connection string. Use the POOLED host (…-pooler.…) for the
# running service; keep the direct (non-pooler) string for migrations, which
# need a session connection for advisory locks.
# [required]
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/clearview?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/clearview?sslmode=require
PG_POOL_MAX=10

# ── Auth secrets ──────────────────────────────────────────────
# Long random values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Two, not four. JWT_SECRET signs the administrator access token (the signing key
# is derived from it, so there is no second signing secret to set), and
# GOODPOST_HASH_PEPPER is used only for the irreversible hash of a client IP in
# the audit log. An ACCESS_TOKEN_TTL / REFRESH_TOKEN_TTL_DAYS / JWT_REFRESH_SECRET
# used to live here; nothing read them, and a variable nothing reads is worse than
# a missing one, because it looks like configuration.
# [required] both
JWT_SECRET=
GOODPOST_HASH_PEPPER=

# ── Reader identity (§3, §15, §16) ────────────────────────────
# The Firebase project a reader's ID token must have been minted for:
#   Firebase console → Project settings → General → Project ID
#
# PUBLIC, and the only Firebase value the server needs. ID tokens are verified
# against Google's published signing certificates, so there is no service-account
# file, no private key, and no Firebase secret in this deployment. It is the same
# project id the Android app ships in google-services.json.
#
# Optional. Empty means public reading works exactly as it did before §3 and the
# reader routes answer `auth_unavailable` — which is the correct failure, because
# the alternative to refusing is trusting a uid the client asserted.
# [prod] FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=

# ── Push notifications (§8) ───────────────────────────────────
# The service account that signs this server's messages to Firebase Cloud
# Messaging: Project settings -> Service accounts -> Generate new private key.
# Paste the whole JSON file as the value, or its base64 encoding if your
# dashboard mangles whitespace. The key's newlines may arrive escaped; this
# service repairs them.
#
# Leave it EMPTY and nothing breaks: new posts are not pushed, and the app's own
# periodic check still delivers them (within fifteen minutes). This is the only
# Firebase secret in the deployment — FIREBASE_PROJECT_ID above is public.
FIREBASE_SERVICE_ACCOUNT_JSON=
# How many devices ONE publish may notify. The rest receive the update through
# the app's own catch-up check.
PUSH_FANOUT_MAX=500

# ── The first super administrator (§17) ───────────────────────
# Reconciled at boot and by `npm run create-admin`. These belong only in the
# host's secret store — never in the Android app, never in git.
#
# Prefer SUPER_ADMIN_PASSWORD_HASH: the bcrypt hash, which is what the server
# would store anyway. SUPER_ADMIN_PASSWORD is accepted as an alternative for a
# deployment holding a plaintext secret; it is hashed once at boot and never
# stored. Generate a hash with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
#
# [prod] SUPER_ADMIN_EMAIL — without it the server refuses to start.
# Changing the password here IS the rotation path: the account is reconciled at
# boot, so a redeploy applies what these variables say. Accounts created from
# inside the app by a super administrator are separate and are never touched.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=
# SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=Good Post Admin

# Shown by the app's "Don't have channel access?" line (§16). Public, and it
# should be the deployment's own address.
ADMIN_CONTACT_EMAIL=
ADMIN_ACCESS_TOKEN_TTL=10m
ADMIN_SESSION_TTL_DAYS=7
# The floor for a channel administrator's password.
ADMIN_MIN_PASSWORD_LENGTH=8

# ── Amazon S3 (needed for post media; text posts work without it) ──
# Backend-controlled uploads only: the Android client never sees these
# credentials. It receives short-lived presigned URLs instead. With no bucket
# set, media uploads answer `media_unavailable` and everything else keeps
# working (§22).
AWS_REGION=eu-central-1
# Only for an S3-COMPATIBLE provider (Cloudflare R2, Backblaze B2, Wasabi).
# Empty means Amazon S3. For R2 it is
# https://<account-id>.r2.cloudflarestorage.com and AWS_REGION becomes `auto`.
AWS_ENDPOINT_URL=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set when running on infrastructure with an attached role, in which case leave
# the two keys above EMPTY and the SDK resolves credentials itself.
AWS_USE_INSTANCE_ROLE=false
S3_UPLOAD_URL_TTL=900
S3_DOWNLOAD_URL_TTL=3600
# Max accepted upload size (bytes), enforced when issuing an upload URL.
S3_MAX_UPLOAD_BYTES=104857600
# An upload URL that was issued but never claimed is swept after this long.
UPLOAD_CLAIM_WINDOW_MINUTES=60

# ── Product rules ─────────────────────────────────────────────
# How many files one post may carry.
MAX_POST_MEDIA=4
# How long an administrator may edit a post after publishing it.
EDIT_WINDOW_DAYS=30
MAX_TEXT_LENGTH=4000
MAX_CHANNEL_NAME_LENGTH=80
MAX_CHANNEL_DESCRIPTION_LENGTH=500
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100
# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=12
WRITE_RATE_LIMIT_MAX=40
# Per-IDENTITY, not per-IP: counts a single account's failed sign-ins and locks
# it, so an attacker cannot spend one address's allowance from many addresses.
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ── Cleanup job ───────────────────────────────────────────────
# Three passes: abandoned uploads, posts an administrator deleted (their rows
# and their S3 objects), and posts past the retention window.
RETENTION_CRON=*/30 * * * *
RETENTION_JOB_ENABLED=true
# How long a post's server-side copy stays (§14). An update older than this is
# deleted for everyone, so a channel is a feed rather than an archive. Set it to
# 0 to keep history indefinitely — 0 means "no window", not "expire now".
POST_RETENTION_DAYS=30
# How long a deleted post's rows survive before the physical delete.
PURGE_GRACE_DAYS=0
# Rows per sweep.
PURGE_BATCH_SIZE=200
