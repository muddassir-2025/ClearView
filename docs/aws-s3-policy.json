{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GoodPostMediaObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:HeadObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE-WITH-YOUR-BUCKET-NAME/*"
    }
  ]
}
