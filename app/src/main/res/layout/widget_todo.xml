<?xml version="1.0" encoding="utf-8"?>
<!-- To-Do widget — a SQUARE card, centred in whatever cell it is given.

     WHY THE CARD IS AN IMAGE RATHER THAN A BOX

     A launcher lays widgets out on a grid of cells, and those cells are almost
     never square: on this device a column is about 82dp wide while a row is
     121dp tall. A card that filled its cell was therefore a tall rectangle —
     which is exactly what it looked like, and why the ring inside it read as
     floating in a box rather than as a dial.

     RemoteViews has no aspect-ratio support, and sizing the card from the
     launcher's reported cell dimensions does not work either: the cell it
     reports (98dp) is larger than the box the widget is actually given (82dp),
     so a card cut to that width is clipped. Both were tried.

     The card is therefore drawn as a square BITMAP by the provider — surface,
     hairline and ring together — and this `ImageView` scales it with
     `scaleType="fitCenter"`, which fits the largest square that its bounds allow.
     The result is square on any launcher, at any grid, with nothing measured and
     no padding constant guessed at. The surface has to be inside the bitmap with
     the arc, because a `background` would stretch across the cell while the ring
     stayed square.

     RemoteViews has no `Canvas`, so an arc cannot be drawn here; that is the
     whole reason the drawing happens in the provider and arrives as a picture.

     A FrameLayout rather than a ConstraintLayout because RemoteViews supports a
     fixed set of layouts, and ConstraintLayout is not among them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_todo_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_todo_fraction"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_verse_text"
        android:textSize="13sp" />
</FrameLayout>
